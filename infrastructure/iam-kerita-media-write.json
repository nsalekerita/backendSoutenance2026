{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListKeritaMedia",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::kerita-media"
    },
    {
      "Sid": "ManageKeritaMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::kerita-media/*"
    }
  ]
}
