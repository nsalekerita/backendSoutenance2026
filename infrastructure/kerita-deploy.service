[Unit]
Description=Pull and deploy Kerita backend from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=APP_DIR=/home/ubuntu/kerita-backend
Environment=DEPLOY_BRANCH=aws-self-hosted-backend
ExecStart=/home/ubuntu/kerita-backend/infrastructure/deploy-ec2.sh
TimeoutStartSec=300
