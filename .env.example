# Serveur
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT (généré par notre propre backend, indépendant de Supabase Auth
# car la table users est gérée manuellement dans la migration fournie)
JWT_SECRET=change-this-super-secret-key
JWT_EXPIRES_IN=7d

# IA - Claude API (pour recommendation.service / chatbot.service / aide-contextuelle.service)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google OAuth (optionnel, pour "Continuer avec Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
