# Serveur
PORT=4000
NODE_ENV=development

# CORS : liste blanche des origines autorisées, séparées par des virgules.
# Obligatoire en production (sinon le CORS refuse tout par défaut) ;
# laisser vide en développement autorise toutes les origines.
# Exemple: CORS_ALLOWED_ORIGINS=https://app.iaihorizon.com,https://admin.iaihorizon.com
CORS_ALLOWED_ORIGINS=

# PostgreSQL AWS RDS
DATABASE_URL=postgresql://supkerita:mot-de-passe@booking-platform-dev.xxxxx.us-east-1.rds.amazonaws.com:5432/kerita
DB_SSL=true
DB_POOL_MAX=10

# Stockage privé S3 exposé uniquement via CloudFront
AWS_REGION=us-east-1
S3_BUCKET=kerita-media
CLOUDFRONT_BASE_URL=https://d35aao9mvdqgiv.cloudfront.net

# JWT émis par le backend (la table users est stockée dans PostgreSQL/RDS)
JWT_SECRET=change-this-super-secret-key
JWT_EXPIRES_IN=7d

# IA - Google Gemini API (pour recommendation.service / chatbot.service / aide-contextuelle.service)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (optionnel, pour "Continuer avec Google")
GOOGLE_CLIENT_ID=
# Le backend vérifie les id_token avec GOOGLE_CLIENT_ID ; aucun secret client
# n'est nécessaire pour ce flux mobile/web.
GOOGLE_CLIENT_SECRET=

# SMTP (envoi des codes OTP : vérification d'e-mail à l'inscription et
# réinitialisation du mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=IAI Horizon <votre-adresse@gmail.com>

# Firebase Admin SDK (notifications push via FCM). JSON du compte de service
# (Firebase Console > Paramètres du projet > Comptes de service > Générer une
# nouvelle clé privée), sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT_JSON=

# create-admin.js (script ponctuel, à fournir uniquement lors de l'exécution,
# pas besoin de les garder dans .env) :
# ADMIN_EMAIL=admin@exemple.com
# ADMIN_PASSWORD=MotDePasseSolide123!
# ADMIN_NOM=Administrateur IAI Horizon

# En production, DATABASE_URL et JWT_SECRET sont obligatoires : le serveur
# refuse de démarrer s'ils manquent.
